# cloudflared stack. Copy to .env.local, chmod 600, never commit. The image tag is not here: deploy.sh
# writes it to .env (CLOUDFLARED_TAG=..., see VERSION.md).
# Cloudflare Zero Trust -> Networks -> Tunnels -> this server's tunnel -> install connector -> copy the token.
# One token per server. Never run the same token on two servers at once: Cloudflare would split visitors
# between them. To move a site to another server: stop cloudflared here first, then use the token there.
TUNNEL_TOKEN=CHANGE_ME
