# postgres stack. Copy to .env.local (03-generate-secrets.sh does it and fills every CHANGE_ME),
# chmod 600, never commit. The image tag is not here: deploy.sh writes it to .env (POSTGRES_TAG=16).
# A new MAJOR version (16 -> 17) is a backup + restore (05-backup.sh, new volume, 04-restore.sh),
# never just a new tag; deploy.sh refuses it on a database that has data.

# Database superuser - for administration only, never used by the applications
POSTGRES_USER=pgsuper
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=postgres

# Database and login role for Strapi, created on first start by initdb/10-create-strapi-db.sh.
# The same three values are in ../tbbe/.env.local as DATABASE_NAME / DATABASE_USERNAME / DATABASE_PASSWORD.
STRAPI_DB_NAME=strapi
STRAPI_DB_USER=strapi
STRAPI_DB_PASSWORD=CHANGE_ME

# Optional pgAdmin (profile "tools")
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME
