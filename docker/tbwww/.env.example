# tbwww stack (website: sales, sign-up, profile, orders). Copy to .env.local (03-generate-secrets.sh does
# it and fills NEXTAUTH_SECRET), chmod 600, never commit. The image tag is not here: deploy.sh writes it
# to .env (TBWWW_TAG=...). Same file as .env.example in the tbwww repo.
# Every value is read at run time by the server, so one image works on every box; change a value,
# then restart the container. Nothing here is built into the image. Never give a value a NEXT_PUBLIC_ name.

# --- Login (NextAuth, against Strapi) ---
# A long random string: openssl rand -base64 32. Not shared with helpapp.
NEXTAUTH_SECRET=CHANGE_ME
# The address users open on THIS box: https://www.timebars.com (prod), https://www.rlan.ca (gmk1),
# http://localhost:3002 (npm run dev). Also this site's own address in links and the sitemap.
NEXTAUTH_URL=CHANGE_ME
# OAuth apps (optional): add <NEXTAUTH_URL>/api/auth/callback/<provider> in each console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Strapi server token (server only) ---
# Confirms OAuth sign-ups and runs the sysadmin docs sync. Strapi admin → Settings → API Tokens.
STRAPI_ADMIN_TOKEN=CHANGE_ME

# --- Stripe (checkout) ---
# Test keys on gmk1 / dev, live keys on prod. The publishable key reaches the browser (that is normal).
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_PUBLISHABLE_KEY=CHANGE_ME

# --- Public addresses for THIS box ---
# Unset = Timebars Ltd. production (be2 / cloud / ab / tb / cb .timebars.com). Set them on any other
# box, e.g. gmk1:
#   CLOUD_API_URL=https://be2.rlan.ca/api
#   CLOUD_URL=https://cloud.rlan.ca
#   RUN_URL_AB=https://agile.rlan.ca
#   RUN_URL_TB=https://pmrm.rlan.ca
#   RUN_URL_CB=https://ppm.rlan.ca
# This site's own address comes from NEXTAUTH_URL (CLOUD_FRONTEND_URL only if it must differ).
# CLOUD_API_URL_GQL (Strapi address for uploaded images) defaults to CLOUD_API_URL without /api.
CLOUD_API_URL=
CLOUD_URL=
RUN_URL_AB=
RUN_URL_TB=
RUN_URL_CB=
