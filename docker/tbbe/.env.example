# tbbe stack (Strapi). Copy to .env.local (03-generate-secrets.sh does it and fills every CHANGE_ME),
# chmod 600, never commit. Use different secrets on every server. The image tag is not here:
# deploy.sh writes it to .env (TBBE_TAG=...).

# --- Database (must match ../postgres/.env.local STRAPI_DB_*) ---
DATABASE_HOST=tbpgdb
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=CHANGE_ME
DATABASE_SSL=false

# --- Strapi secrets (required; each one random, generated once) ---
APP_KEYS=CHANGE_ME
API_TOKEN_SALT=CHANGE_ME
ADMIN_JWT_SECRET=CHANGE_ME
TRANSFER_TOKEN_SALT=CHANGE_ME
JWT_SECRET=CHANGE_ME

# --- This server's addresses ---
HOST=0.0.0.0
PORT=1337
# Strapi's own public address (no /api), e.g. https://be2.timebars.com (prod), https://be2.rlan.ca (gmk1)
PUBLIC_URL=CHANGE_ME
# Browser addresses allowed to call Strapi (comma separated; *.example.com allows every sub-domain).
# Every app, website and Cloud address on this server, e.g. https://*.rlan.ca
CORS_ORIGINS=CHANGE_ME

# --- Email (registration, password reset) via SendGrid; leave the key empty to run without email ---
SENDGRID_API_KEY=
EMAIL_FROM=noreply@example.com
EMAIL_REPLY_TO=support@example.com
