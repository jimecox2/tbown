# Copy to .env (scripts/04-generate-secrets.sh does this and fills the CHANGE_ME values).
# chmod 600 .env - never commit it. Use different secrets on every server.

TBBE_TAG=latest
NODE_ENV=production

# --- Database (must match ../postgres/.env STRAPI_DB_*) ---
DATABASE_HOST=tbpgdb
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=CHANGE_ME
DATABASE_SSL=false

# --- Strapi secrets (required; each one random, generated once) ---
APP_KEYS=CHANGE_ME
API_TOKEN_SALT=CHANGE_ME
ADMIN_JWT_SECRET=CHANGE_ME
TRANSFER_TOKEN_SALT=CHANGE_ME
JWT_SECRET=CHANGE_ME

# --- Your public addresses ---
BE_URL=https://be2.example.com
FE_URL=https://www.example.com

# --- Email (registration, password reset) via SendGrid; leave empty to run without email ---
SENDGRID_API_KEY=

# --- Optional ---
# Full-access API token: create it in the Strapi admin (Settings -> API Tokens) after first start,
# only if your website needs it. Server side only.
FULL_ACCESS_ADMIN_TOKEN=
# Stripe: only for a service provider (Option D)
STRIPE_PK=
