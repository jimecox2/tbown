# Copy to .env.local on the server (03-generate-secrets.sh does it), chmod 600, never commit.
# Server-side only: never give a secret a NEXT_PUBLIC_ name.

# Your own Google Gemini key (aistudio.google.com), restricted to the Generative Language API.
# Without it AI answers an error; the rest of the system is unaffected.
GEMINI_API_KEY=

# Login check: the user's Timebars Cloud login is verified against Strapi. Inside this stack:
STRAPI_URL=http://tbbe:1337/api
# Only for a site with no Strapi: AI_REQUIRE_LOGIN=false (then keep this server LAN-only)
# AI_REQUIRE_LOGIN=false

# Timebars Cloud sign-in (cloud.example.com: Enterprise Dashboard, notifications, AI help pages).
# Both are required, or Sign In ends on https://0.0.0.0:3010/auth/error?error=Configuration.
# NEXTAUTH_SECRET is generated by 03-generate-secrets.sh. NEXTAUTH_URL is the Cloud address users open.
NEXTAUTH_SECRET=CHANGE_ME
NEXTAUTH_URL=https://cloud.example.com
# Public addresses the Cloud pages use in the browser (read at run time). Your Strapi API and your
# accounts site; without them the pages use Timebars Ltd.'s own servers.
CLOUD_API_URL=https://be2.example.com/api
CLOUD_WWW_URL=https://www.example.com
# Strapi API token (Strapi admin -> Settings -> API Tokens, full access). Server only, never NEXT_PUBLIC_.
# Needed to save or share dashboard sources and for Users & Roles.
STRAPI_ADMIN_TOKEN=

# Optional limits (defaults shown)
# AI_RATE_LIMIT_PER_MIN=30
# AI_MAX_BODY_BYTES=10485760
