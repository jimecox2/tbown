# Copy to .env.local on the server (03-generate-secrets.sh does it), chmod 600, never commit.
# Server-side only: never give a secret a NEXT_PUBLIC_ name.

# Your own Google Gemini key (aistudio.google.com), restricted to the Generative Language API.
# Without it AI answers an error; the rest of the system is unaffected.
GEMINI_API_KEY=

# Login check: the user's Timebars Cloud login is verified against Strapi. Inside this stack:
STRAPI_URL=http://tbbe:1337/api
# Only for a site with no Strapi: AI_REQUIRE_LOGIN=false (then keep this server LAN-only)
# AI_REQUIRE_LOGIN=false

# Optional limits (defaults shown)
# AI_RATE_LIMIT_PER_MIN=30
# AI_MAX_BODY_BYTES=10485760
