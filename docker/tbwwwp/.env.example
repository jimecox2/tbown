# DRAFT - the website image is being reworked so that it reads its addresses at run time and keeps
# every secret server-side. Until that release, the current image has Timebars Ltd. addresses built
# in, and the NEXT_PUBLIC_* values below only affect server-side code.
# Copy to .env, chmod 600, never commit. Never give a secret a NEXT_PUBLIC_ name.

TBWWW_TAG=latest
NODE_ENV=production
PORT=3001
HOSTNAME=0.0.0.0

# --- Your addresses ---
NEXT_PUBLIC_WWW_URL=https://www.example.com
NEXT_PUBLIC_API_URL=https://be2.example.com/api
NEXTAUTH_URL=https://www.example.com
NEXTAUTH_URL_INTERNAL=http://localhost:3001

# --- Secrets (server side only) ---
AUTH_SECRET=CHANGE_ME
NEXTAUTH_SECRET=CHANGE_ME
NOTIFICATION_STRAPI_KEY=

# --- Notifications (optional) ---
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
SYSTEM_ADMIN_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Option D (service provider) only ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
